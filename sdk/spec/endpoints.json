{
  "spec": "whitewater-protocol",
  "version": "1.0.0",
  "status": "draft",
  "scalar_types": {
    "uuid": "canonical UUID string",
    "i64ns": "signed 64-bit integer encoded as a decimal string",
    "bytes": "standard base64 string",
    "cursor": "opaque string | null; pass-through, never parse",
    "metadata": "object mapping UTF-8 names to base64 byte values",
    "name": "dotted lowercase name ^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$ max 512 bytes"
  },
  "common_types": {
    "Record": {
      "cursor": "cursor",
      "message_id": "uuid",
      "producer_id": "uuid",
      "sequence": "u64",
      "event_time_ns": "i64ns",
      "ingest_time_ns": "i64ns",
      "key_base64": "bytes",
      "payload_base64": "bytes",
      "metadata_base64": "metadata",
      "source": "RecordSource"
    },
    "RecordSource": {
      "feed_name": "string (last dotted Feed segment, e.g. created)",
      "full_feed_name": "string (Domain-qualified, e.g. orders.created)",
      "feed_id": "uuid (immutable identity; nil for prototype streams)"
    },
    "WriterServerFeedback": {
      "recommended_batch_count": "u64",
      "recommended_batch_bytes": "u64",
      "pressure": "f64",
      "retry_after_ms": "u64",
      "max_frame_bytes": "u64",
      "hot_key": "bool (default false)"
    },
    "WriterAppendResponse": {
      "message_id": "uuid",
      "cursor": "cursor",
      "deduplicated": "bool",
      "durability": "string",
      "feedback": "WriterServerFeedback"
    },
    "StatementResult": {
      "statement": "string",
      "message": "string",
      "data": "object (statement-specific)"
    },
    "ControlExecution": {
      "request_id": "uuid",
      "revision": "u64",
      "authority": "string (e.g. control_plane)",
      "warning": "string",
      "results": "StatementResult[]"
    }
  },
  "endpoints": [
    {
      "op": "health",
      "method": "GET",
      "path": "/health",
      "auth": "none",
      "response": {
        "status": "string"
      },
      "notes": "liveness; any Node"
    },
    {
      "op": "admin.wcl",
      "method": "POST",
      "path": "/v1/admin/wcl",
      "auth": "admin",
      "request": {
        "request_id": "uuid?",
        "script": "string"
      },
      "response": "ControlExecution",
      "errors": [
        "refused(400) syntax/exists/not-found",
        "unavailable(503) quorum"
      ]
    },
    {
      "op": "admin.commands",
      "method": "POST",
      "path": "/v1/admin/commands",
      "auth": "admin",
      "request": {
        "request_id": "uuid?",
        "commands": "Command[]"
      },
      "response": "ControlExecution",
      "errors": [
        "refused(400)",
        "unavailable(503)"
      ]
    },
    {
      "op": "writer.append",
      "method": "POST",
      "path": "/v1/writers/append",
      "auth": "admin (client-key scoped auth is future work)",
      "request": {
        "request_id": "uuid",
        "writer": "name",
        "session_epoch": "u64",
        "event_time_ns": "i64ns?",
        "key_base64": "bytes",
        "payload_base64": "bytes",
        "metadata_base64": "metadata"
      },
      "response": "WriterAppendResponse",
      "errors": [
        "conflict(409) stale_epoch/fencing",
        "unavailable(503) freeze/quorum; retry identical request_id"
      ]
    },
    {
      "op": "writer.append_batch",
      "method": "POST",
      "path": "/v1/writers/append-batch",
      "auth": "admin",
      "request": {
        "records": "WriterSessionAppendRequest[] (bounded)"
      },
      "response": {
        "results": "WriterAppendResponse[]",
        "feedback": "WriterServerFeedback"
      },
      "errors": [
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "reader.open",
      "method": "POST",
      "path": "/v1/readers/open",
      "auth": "admin",
      "request": {
        "request_id": "uuid",
        "reader": "name",
        "capacity": "u64"
      },
      "response": {
        "reader_id": "uuid",
        "feed_id": "uuid",
        "session_epoch": "u64",
        "capacity": "u64",
        "delivered_cursor": "cursor",
        "acknowledged_cursor": "cursor"
      },
      "errors": [
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "reader.fetch",
      "method": "POST",
      "path": "/v1/readers/fetch",
      "auth": "admin",
      "request": {
        "request_id": "uuid",
        "reader": "name",
        "session_epoch": "u64",
        "limit": "u64?"
      },
      "response": {
        "records": "Record[]",
        "delivered_cursor": "cursor",
        "acknowledged_cursor": "cursor",
        "recommended_capacity": "u64",
        "retry_after_ms": "u64"
      },
      "errors": [
        "conflict(409) stale_epoch",
        "unavailable(503)"
      ]
    },
    {
      "op": "reader.ack",
      "method": "POST",
      "path": "/v1/readers/ack",
      "auth": "admin",
      "request": {
        "request_id": "uuid",
        "reader": "name",
        "session_epoch": "u64",
        "cursor": "cursor"
      },
      "response": "ReaderSessionResponse",
      "errors": [
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "reader.close",
      "method": "POST",
      "path": "/v1/readers/close",
      "auth": "admin",
      "request": "same shape as reader.fetch",
      "response": "ReaderSessionResponse",
      "errors": [
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "reader.temporary_fetch",
      "method": "POST",
      "path": "/v1/readers/temporary/fetch",
      "auth": "admin",
      "request": {
        "feed": "name",
        "after": "cursor?",
        "limit": "u64?",
        "new_only": "bool",
        "tail": "bool",
        "wait_ms": "u64?",
        "after_event_time_ns": "i64ns?"
      },
      "response": {
        "records": "Record[]",
        "next_cursor": "cursor"
      },
      "errors": [
        "refused(400) invalid combination",
        "unavailable(503)"
      ]
    },
    {
      "op": "feed.records",
      "method": "GET",
      "path": "/v1/feeds/records?feed=<name>&limit=<n>&after=<cursor>",
      "auth": "admin",
      "response": "Record[]",
      "errors": [
        "unavailable(503)"
      ]
    },
    {
      "op": "feed.append",
      "method": "POST",
      "path": "/v1/feeds/append",
      "auth": "admin",
      "request": {
        "request_id": "uuid",
        "feed": "name",
        "writer_session_id": "uuid",
        "writer_epoch": "u64",
        "sequence": "u64",
        "event_time_ns": "i64ns?",
        "key_base64": "base64",
        "payload_base64": "base64",
        "metadata_base64": {
          "name": "base64"
        }
      },
      "response": "WriterAppendResponse",
      "errors": [
        "refused(400) stale writer sequence",
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.join",
      "method": "POST",
      "path": "/v1/subscriptions/members/join",
      "auth": "admin",
      "request": {
        "subscription": "name",
        "request_id": "uuid",
        "member_id": "uuid"
      },
      "response": "SubscriptionMemberResponse { member_epoch, tick, ownership_epoch }",
      "errors": [
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.claim",
      "method": "POST",
      "path": "/v1/subscriptions/members/claim",
      "auth": "admin",
      "request": {
        "subscription": "name",
        "request_id": "uuid",
        "member_id": "uuid",
        "member_epoch": "u64",
        "work_id": "uuid",
        "lease_ticks": "u64? (default 30, max 600)",
        "lease_epoch": "u64?"
      },
      "response": "SubscriptionMemberResponse { lease: { work_id, member_id, member_epoch, lease_epoch, expires_at_tick } }",
      "errors": [
        "lease.busy(409)",
        "lease.capacity(409)",
        "lease.stale_lease(409)",
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.renew",
      "method": "POST",
      "path": "/v1/subscriptions/members/renew",
      "auth": "admin",
      "request": "same shape as claim (lease_epoch required)",
      "errors": [
        "lease.stale_lease(409)",
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.release",
      "method": "POST",
      "path": "/v1/subscriptions/members/release",
      "auth": "admin",
      "request": {
        "subscription": "name",
        "request_id": "uuid",
        "member_id": "uuid",
        "member_epoch": "u64",
        "work_id": "uuid",
        "lease_epoch": "u64"
      },
      "errors": [
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.transfer",
      "method": "POST",
      "path": "/v1/subscriptions/members/transfer",
      "auth": "admin",
      "request": {
        "subscription": "name",
        "request_id": "uuid",
        "work_id": "uuid",
        "member_id": "uuid (current holder — fencing evidence)",
        "lease_epoch": "u64 (holder's grant epoch)",
        "to_member_id": "uuid",
        "to_member_epoch": "u64 (target's current member epoch)",
        "lease_ticks": "u64?"
      },
      "response": "SubscriptionMemberResponse { lease }",
      "errors": [
        "lease.stale_lease(409)",
        "lease.capacity(409)",
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.fetch",
      "method": "POST",
      "path": "/v1/subscriptions/members/fetch",
      "auth": "admin",
      "request": {
        "subscription": "name",
        "request_id": "uuid",
        "member_id": "uuid",
        "member_epoch": "u64",
        "work_id": "uuid",
        "lease_epoch": "u64",
        "limit": "u64? (clamped 1..256)"
      },
      "response": {
        "request_id": "uuid",
        "records": "Record[]",
        "cursor": "cursor",
        "positions": "map<string,string>",
        "ownership_epoch": "u64"
      },
      "errors": [
        "lease.stale_lease(409)",
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.ack",
      "method": "POST",
      "path": "/v1/subscriptions/members/ack",
      "auth": "admin",
      "request": {
        "subscription": "name",
        "request_id": "uuid",
        "member_id": "uuid",
        "member_epoch": "u64",
        "work_id": "uuid",
        "lease_epoch": "u64",
        "cursor": "cursor?",
        "positions": "map<string,string>?"
      },
      "response": "SubscriptionMemberResponse",
      "errors": [
        "lease.stale_lease(409)",
        "conflict(409)",
        "unavailable(503)"
      ]
    },
    {
      "op": "subscription.member.state",
      "method": "GET",
      "path": "/v1/subscriptions/members/state?subscription=<name>",
      "auth": "admin",
      "response": "members, leases, frontier",
      "errors": [
        "unavailable(503)"
      ]
    },
    {
      "op": "admin.demand.hot_keys",
      "method": "GET",
      "path": "/v1/admin/demand/hot-keys",
      "auth": "admin",
      "response": {
        "hot_keys": [
          {
            "feed": "name",
            "range_id": "string",
            "range_start": "string",
            "range_end_exclusive": "string|null",
            "token": "string",
            "share_bps": "u64",
            "window_records": "u64",
            "window_bytes": "u64",
            "next_token": "string|null",
            "isolating_boundary": "string|null"
          }
        ]
      },
      "errors": []
    },
    {
      "op": "admin.subscriptions.progress",
      "method": "GET",
      "path": "/v1/admin/subscriptions/progress?subscription=<name>",
      "auth": "admin",
      "response": "assignment + committed frontier + member/lease summary + per-replica reachability",
      "errors": []
    },
    {
      "op": "node.metrics",
      "method": "GET",
      "path": "/v1/node/metrics",
      "auth": "admin",
      "response": "node-local counters incl. demand",
      "errors": []
    },
    {
      "op": "cluster.members",
      "method": "GET",
      "path": "/v1/cluster/members",
      "auth": "admin",
      "response": "discovery view (not consensus)",
      "errors": []
    },
    {
      "op": "state_store.mutate",
      "method": "POST",
      "path": "/v1/state-stores/mutate",
      "auth": "admin (client-key scoped auth is future work)",
      "request": {
        "store": "name",
        "mutation_id": "uuid (caller idempotency identity)",
        "op": "put_row{key_base64,payload_base64} | delete_row{key_base64}"
      },
      "response": {
        "store_id": "uuid",
        "mutation_id": "uuid",
        "sequence": "u64 (store-local journal order)",
        "deduplicated": "bool"
      },
      "errors": [
        "refused(400) feed-sourced store / missing store / bounds",
        "conflict(409) mutation_id reused with different content",
        "unavailable(503) no quorum; retry identical mutation_id"
      ],
      "notes": "manual StateStores only; RF3 journal quorum commits before ack; sequence is owner-allocated"
    },
    {
      "op": "state_store.sync",
      "method": "POST",
      "path": "/v1/state-stores/sync",
      "auth": "admin",
      "request": {
        "store": "name"
      },
      "response": {
        "store_id": "uuid",
        "applied": "u64 (records committed this pass)",
        "frontier": "string|null (source cursor)",
        "complete": "bool (reached committed tip)"
      },
      "errors": [
        "refused(400) manual StateStore / missing store",
        "conflict(409) source Feed gone or frontier outside retained history; rebuild required",
        "unavailable(503) no journal quorum / transient read failure"
      ],
      "notes": "resumes from the durable journaled frontier; records dedupe by deterministic replay identity"
    },
    {
      "op": "state_store.rebuild",
      "method": "POST",
      "path": "/v1/state-stores/rebuild",
      "auth": "admin",
      "request": {
        "store": "name",
        "token": "uuid|null (caller retry identity for the pass)"
      },
      "response": {
        "store_id": "uuid",
        "applied": "u64",
        "frontier": "string|null",
        "complete": "bool"
      },
      "errors": [
        "refused(400) manual StateStore / missing store",
        "conflict(409) source Feed gone; required history cannot rematerialize",
        "unavailable(503) no journal quorum"
      ],
      "notes": "re-materializes from retained source beginning; token namespaces replay identities so rows re-apply; same-token retries dedupe"
    },
    {
      "op": "state_store.lookup",
      "method": "POST",
      "path": "/v1/state-stores/lookup",
      "auth": "admin (client-key scoped auth is future work)",
      "request": {
        "store": "name",
        "key_base64": "bytes (primary row key)",
        "strict": "bool (optional; wait for the replica's applied sequence to reach its committed snapshot before serving)",
        "wait_ms": "u64 (optional, default 500, capped at 2000; bounds the strict freshness wait)"
      },
      "response": {
        "store_id": "uuid",
        "found": "bool",
        "payload_base64": "bytes|null",
        "applied_cursor": "string|null (journal-sequence cursor the row last applied at)",
        "applied_seq": "u64 (highest journal sequence applied by the serving replica)",
        "committed_seq": "u64 (highest committed sequence on the serving replica)",
        "behind": "bool (applied_seq < committed_seq: replica still applying)",
        "served_by": "string (Node identity that served the row)"
      },
      "errors": [
        "refused(400) missing store / empty or oversized key",
        "unavailable(503) no replica could serve the lookup",
        "conflict(409) code=index_behind: strict freshness unreachable within the bounded wait"
      ],
      "notes": "primary-key point read; served locally when the ingress Node holds a replica, else forwarded over the authenticated internal read route; non-strict requests report freshness honestly via behind/applied_seq/committed_seq; strict requests wait (bounded) and return index_behind rather than serve a stale snapshot"
    },
    {
      "op": "index.query",
      "method": "POST",
      "path": "/v1/indexes/query",
      "auth": "admin (client-key scoped auth is future work)",
      "request": {
        "index": "logical Index name (space/feed-scoped catalog definition)",
        "mode": "exact | prefix | range",
        "values": "[typed] exact only: one per declared field ({kind: null|bool|i64|text|bytes, value|value_base64})",
        "leading": "[typed] prefix/range only: leading exact-equal fields (default [])",
        "partial_text": "string (prefix only; narrows the field after leading)",
        "lower": "bound (range only: {value: typed, inclusive: bool default true})",
        "upper": "bound (range only: {value: typed, inclusive: bool default true})",
        "limit": "usize (optional, default 256, bounded 1..=1000; results cap at 16 MiB)",
        "strict": "bool (optional; serving Node bounded-waits for its checkpoint to reach the activation frontier)",
        "wait_ms": "u64 (optional, default 500, capped at 2000; bounds the strict freshness wait)"
      },
      "response": {
        "index": "string (logical name)",
        "index_id": "uuid",
        "generation": "u64 (active generation that served)",
        "rows": "[{key_base64, payload_base64}]",
        "applied_cursor": "string|null (posting frontier materialized by the serving Node)",
        "target_cursor": "string|null (committed activation frontier)",
        "behind": "bool (applied_cursor lags target_cursor)",
        "truncated": "bool (limit cut the result)",
        "served_by": "string (Node identity that served)"
      },
      "errors": [
        "refused(400) invalid predicate shape/width/limit or corrupt key encoding",
        "not_found(404) code=index_not_found: unknown Index",
        "conflict(409) code=index_not_ready: declared or building — activate a completed generation first",
        "conflict(409) code=index_behind: strict freshness unreachable within the bounded wait",
        "unavailable(503) no Node could serve the query",
        "internal(500) code=index_corrupt: dangling posting or inconsistent primary row"
      ],
      "notes": "logical GET/exact/prefix/range over persisted Indexes; physical ranges/replicas stay hidden — ingress serves locally when it materializes the generation, else forwards (bounded) over the authenticated internal index/query route; strict waits and reports index_behind rather than serving a stale snapshot; WCL GET INDEX runs the identical data-plane path"
    }
  ]
}